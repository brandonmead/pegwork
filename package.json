{
	"name": "pegwork",
	"version": "0.1.0",
	"private": true,
	"description": "Pegwork Platform for WordPress: block editor assets.",
	"license": "GPL-2.0-or-later",
	"author": "Brandon Mead",
	"engines": {
		"node": ">=22.22.2"
	},
	"scripts": {
		"build": "wp-scripts build editor-panel=./assets/src/editor-panel/index.js listings-editor=./assets/src/listings-editor/index.js options-page=./assets/src/options-page/index.js forms-editor=./assets/src/forms-editor/index.js forms-builder=./assets/src/forms-builder/index.js --output-path=assets/build",
		"start": "wp-scripts start editor-panel=./assets/src/editor-panel/index.js listings-editor=./assets/src/listings-editor/index.js options-page=./assets/src/options-page/index.js forms-editor=./assets/src/forms-editor/index.js forms-builder=./assets/src/forms-builder/index.js --output-path=assets/build",
		"lint:js": "wp-scripts lint-js",
		"test:unit": "wp-scripts test-unit-js",
		"test:e2e": "playwright test",
		"wp-env": "wp-env"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@playwright/test": "1.63.0",
		"@wordpress/env": "11.16.0",
		"@wordpress/scripts": "36.0.0",
		"vite": "8.3.1",
		"vitest": "5.0.3"
	}
}
