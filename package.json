{
	"name": "pegwork",
	"version": "0.2.0",
	"private": true,
	"description": "Pegwork Platform for WordPress: block editor assets.",
	"license": "GPL-2.0-or-later",
	"author": "Brandon Mead",
	"engines": {
		"node": ">=22.22.2"
	},
	"scripts": {
		"build": "wp-scripts build editor-panel=./assets/src/editor-panel/index.js listings-editor=./assets/src/listings-editor/index.js options-page=./assets/src/options-page/index.js forms-editor=./assets/src/forms-editor/index.js filters-editor=./assets/src/filters-editor/index.js forms-builder=./assets/src/forms-builder/index.js forms-view=./assets/src/forms-view/index.js automation-builder=./assets/src/automation-builder/index.js automation-actions=./assets/src/automation-actions/index.js --experimental-modules --output-path=assets/build",
		"start": "wp-scripts start editor-panel=./assets/src/editor-panel/index.js listings-editor=./assets/src/listings-editor/index.js options-page=./assets/src/options-page/index.js forms-editor=./assets/src/forms-editor/index.js filters-editor=./assets/src/filters-editor/index.js forms-builder=./assets/src/forms-builder/index.js forms-view=./assets/src/forms-view/index.js automation-builder=./assets/src/automation-builder/index.js automation-actions=./assets/src/automation-actions/index.js --experimental-modules --output-path=assets/build",
		"check:size": "node bin/check-script-size.js assets/build/filters-view.js 10240 && node bin/check-script-size.js assets/build/automation-builder.js 27136 && node bin/check-script-size.js assets/build/automation-actions.js 3072",
		"lint:js": "wp-scripts lint-js",
		"test:unit": "wp-scripts test-unit-js",
		"test:e2e": "playwright test",
		"make-pot": "npm run build && wp i18n make-pot . languages/pegwork.pot --slug=pegwork --domain=pegwork --exclude=assets/src,bin,docs,examples,dist,test-results,playwright-report --headers='{\"Report-Msgid-Bugs-To\":\"https://github.com/brandonmead/pegwork/issues\"}'",
		"zip": "bash bin/build-zip.sh",
		"wp-env": "wp-env"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@playwright/test": "1.63.0",
		"@wordpress/env": "11.16.0",
		"@wordpress/scripts": "36.0.0",
		"vite": "8.3.3",
		"vitest": "5.0.3"
	}
}
