{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/brandonmead/pegwork/schema/registry.schema.json",
	"title": "Pegwork registry package file",
	"description": "One file of a Pegwork schema package: manifest.json, content-types/*.json, taxonomies/*.json, relationships/*.json, forms/*.json, automations/*.json or options-pages/*.json. Validate a specific file against #/$defs/manifest, #/$defs/content_type, #/$defs/taxonomy, #/$defs/relationship, #/$defs/form, #/$defs/automation or #/$defs/options_page. The PHP validator (src/Registry/Validator.php) is the runtime truth; checks that span objects (references, duplicate keys, field types behind a reference) exist only there. Reference: docs/registry-reference.md.",
	"anyOf": [
		{ "$ref": "#/$defs/manifest" },
		{ "$ref": "#/$defs/content_type" },
		{ "$ref": "#/$defs/taxonomy" },
		{ "$ref": "#/$defs/relationship" },
		{ "$ref": "#/$defs/form" },
		{ "$ref": "#/$defs/automation" },
		{ "$ref": "#/$defs/options_page" }
	],
	"$defs": {
		"format": {
			"description": "File format version.",
			"type": "integer",
			"const": 1
		},
		"key": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9_]*$"
		},
		"bounded_key": {
			"description": "Form, automation and options page key: at most 64 characters.",
			"allOf": [
				{ "$ref": "#/$defs/key" },
				{ "maxLength": 64 }
			]
		},
		"object_key": {
			"description": "Content type or taxonomy key: not a reserved WordPress term and not prefixed wp_.",
			"allOf": [
				{ "$ref": "#/$defs/key" },
				{ "not": { "pattern": "^wp_" } },
				{ "not": { "$ref": "#/$defs/reserved_key" } }
			]
		},
		"reserved_key": {
			"enum": [
				"action", "attachment", "attachment_id", "author", "author_name", "calendar", "cat", "category",
				"category__and", "category__in", "category__not_in", "category_name", "comments_per_page",
				"comments_popup", "cpage", "custom", "custom_css", "customize_changeset", "customize_messenger_channel",
				"customized", "day", "debug", "embed", "error", "exact", "favicon", "feed", "fields", "hour",
				"link_category", "m", "minute", "monthnum", "more", "name", "nav_menu", "nav_menu_item", "nonce",
				"nopaging", "oembed_cache", "offset", "order", "orderby", "p", "page", "page_id", "paged", "pagename",
				"pb", "perm", "post", "post__in", "post__not_in", "post_format", "post_mime_type", "post_parent",
				"post_parent__in", "post_parent__not_in", "post_status", "post_tag", "post_type", "posts",
				"posts_per_archive_page", "posts_per_page", "preview", "rest_route", "revision", "robots", "s", "search",
				"second", "sentence", "showposts", "sitemap", "static", "status", "subpost", "subpost_id", "tag",
				"tag__and", "tag__in", "tag__not_in", "tag_id", "tag_slug__and", "tag_slug__in", "taxonomy", "tb",
				"term", "terms", "theme", "title", "type", "types", "user_request", "w", "withcomments",
				"withoutcomments", "year"
			]
		},
		"reserved_option_name": {
			"description": "Core option names (populate_options() plus a few added later). An options page key is its option name.",
			"enum": [
				"active_plugins", "admin_email", "admin_email_lifespan", "auto_plugin_theme_update_emails",
				"auto_update_core_dev", "auto_update_core_major", "auto_update_core_minor", "avatar_default",
				"avatar_rating", "blog_charset", "blog_public", "blogdescription", "blogname", "can_compress_scripts",
				"category_base", "close_comments_days_old", "close_comments_for_old_posts", "comment_max_links",
				"comment_moderation", "comment_order", "comment_previously_approved", "comment_registration",
				"comments_notify", "comments_per_page", "cron", "date_format", "db_version", "default_category",
				"default_comment_status", "default_comments_page", "default_email_category", "default_link_category",
				"default_ping_status", "default_pingback_flag", "default_post_format", "default_role", "disallowed_keys",
				"finished_splitting_shared_terms", "fresh_site", "gmt_offset", "hack_file", "home", "html_type",
				"image_default_align", "image_default_link_type", "image_default_size", "initial_db_version",
				"large_size_h", "large_size_w", "link_manager_enabled", "links_updated_date_format", "mailserver_login",
				"mailserver_pass", "mailserver_port", "mailserver_url", "medium_large_size_h", "medium_large_size_w",
				"medium_size_h", "medium_size_w", "moderation_keys", "moderation_notify", "page_comments",
				"page_for_posts", "page_on_front", "permalink_structure", "ping_sites", "posts_per_page", "posts_per_rss",
				"recently_activated", "recently_edited", "require_name_email", "rewrite_rules", "rss_use_excerpt",
				"show_avatars", "show_comments_cookies_opt_in", "show_on_front", "sidebars_widgets", "site_icon",
				"siteurl", "start_of_week", "sticky_posts", "stylesheet", "tag_base", "template", "theme_switched",
				"thread_comments", "thread_comments_depth", "thumbnail_crop", "thumbnail_size_h", "thumbnail_size_w",
				"time_format", "timezone_string", "uninstall_plugins", "upload_path", "upload_url_path",
				"uploads_use_yearmonth_folders", "use_smilies", "use_trackback", "users_can_register",
				"widget_categories", "widget_rss", "widget_text"
			]
		},
		"text": {
			"type": "string",
			"minLength": 1
		},
		"texts": {
			"type": "array",
			"items": { "$ref": "#/$defs/text" }
		},
		"capability": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9_]*$"
		},
		"not_callable": {
			"description": "Property names that look like PHP callables are never allowed.",
			"not": { "pattern": "(callback|_cb|_class)$" }
		},
		"free": {
			"description": "Free-form JSON data (reserved properties such as automation ui); callable-looking names are still rejected.",
			"propertyNames": { "$ref": "#/$defs/not_callable" },
			"additionalProperties": { "$ref": "#/$defs/free" },
			"items": { "$ref": "#/$defs/free" }
		},
		"labels": {
			"type": "object",
			"required": [ "singular", "plural" ],
			"additionalProperties": false,
			"properties": {
				"singular": { "$ref": "#/$defs/text" },
				"plural": { "$ref": "#/$defs/text" }
			}
		},
		"manifest": {
			"title": "Package manifest (manifest.json)",
			"type": "object",
			"required": [ "format", "id", "version", "label" ],
			"additionalProperties": false,
			"properties": {
				"format": { "$ref": "#/$defs/format" },
				"id": { "$ref": "#/$defs/key" },
				"version": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
				},
				"label": { "$ref": "#/$defs/text" },
				"requires": {
					"description": "Version constraints by plugin slug, such as { \"pegwork\": \">=0.2.0\" }.",
					"type": "object",
					"propertyNames": { "$ref": "#/$defs/not_callable" },
					"additionalProperties": { "$ref": "#/$defs/text" }
				}
			}
		},
		"content_type": {
			"title": "Content type (content-types/<key>.json)",
			"type": "object",
			"required": [ "format", "key", "labels" ],
			"additionalProperties": false,
			"properties": {
				"format": { "$ref": "#/$defs/format" },
				"key": {
					"allOf": [
						{ "$ref": "#/$defs/object_key" },
						{ "maxLength": 20 }
					]
				},
				"labels": { "$ref": "#/$defs/labels" },
				"public": { "type": "boolean", "default": true },
				"taxonomies": {
					"type": "array",
					"items": { "$ref": "#/$defs/taxonomy_usage" }
				},
				"fields": {
					"type": "array",
					"items": { "$ref": "#/$defs/field" }
				},
				"listing": { "$ref": "#/$defs/listing" },
				"wp": {
					"description": "WordPress-only settings.",
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"rest_base": { "$ref": "#/$defs/text" },
						"rewrite_slug": { "$ref": "#/$defs/text" },
						"has_archive": { "type": "boolean" },
						"menu_icon": { "$ref": "#/$defs/text" },
						"supports": { "$ref": "#/$defs/texts" },
						"capability_type": { "$ref": "#/$defs/text" },
						"allowed_blocks": { "$ref": "#/$defs/texts" }
					}
				}
			}
		},
		"taxonomy_usage": {
			"type": "object",
			"required": [ "key" ],
			"additionalProperties": false,
			"properties": {
				"key": { "$ref": "#/$defs/key" },
				"select": { "enum": [ "single", "multi" ], "default": "multi" },
				"required": { "type": "boolean", "default": false }
			}
		},
		"field": {
			"type": "object",
			"required": [ "key", "type", "label" ],
			"additionalProperties": false,
			"properties": {
				"key": {
					"description": "Not id, status or type: record events and automation paths use those for the post itself.",
					"allOf": [
						{ "$ref": "#/$defs/key" },
						{ "not": { "enum": [ "id", "status", "type" ] } }
					]
				},
				"type": { "enum": [ "text", "textarea", "rich_text", "url", "email", "boolean", "date", "number", "select" ] },
				"label": { "$ref": "#/$defs/text" },
				"required": { "type": "boolean", "default": false },
				"visibility": { "enum": [ "public", "private" ], "default": "public" },
				"default": {},
				"options": {
					"type": "array",
					"items": { "$ref": "#/$defs/option" }
				},
				"required_when": { "$ref": "#/$defs/condition" },
				"show_when": { "$ref": "#/$defs/condition" },
				"validate": { "$ref": "#/$defs/validate" },
				"wp": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"storage": {
							"description": "Store in a post column instead of meta.",
							"enum": [ "post_title", "post_content" ]
						},
						"meta_key": {
							"description": "Meta key override (default _{post_type}_{field}); meta storage only.",
							"type": "string",
							"pattern": "^_?[A-Za-z][A-Za-z0-9_]*$"
						}
					},
					"not": { "required": [ "storage", "meta_key" ] }
				}
			},
			"allOf": [
				{
					"if": { "required": [ "visibility", "wp" ], "properties": { "visibility": { "const": "private" }, "wp": { "required": [ "meta_key" ] } } },
					"then": { "properties": { "wp": { "properties": { "meta_key": { "pattern": "^_" } } } } }
				},
				{
					"description": "Private fields cannot be stored in post_title or post_content: those columns are public.",
					"if": { "required": [ "visibility" ], "properties": { "visibility": { "const": "private" } } },
					"then": { "properties": { "wp": { "not": { "required": [ "storage" ] } } } }
				},
				{ "$ref": "#/$defs/field_type_rules" }
			]
		},
		"field_type_rules": {
			"description": "Rules that follow from a field's type, shared by content type, options page and unbound form fields.",
			"allOf": [
				{
					"if": { "required": [ "type" ], "properties": { "type": { "const": "select" } } },
					"then": { "required": [ "options" ] },
					"else": { "properties": { "options": false } }
				},
				{
					"if": { "required": [ "type" ], "properties": { "type": { "enum": [ "text", "textarea", "rich_text", "url", "email", "select" ] } } },
					"then": { "properties": { "default": { "type": "string" } } }
				},
				{
					"if": { "required": [ "type" ], "properties": { "type": { "enum": [ "text", "textarea", "rich_text", "url", "email" ] } } },
					"then": { "properties": { "validate": { "propertyNames": { "enum": [ "min_length", "max_length", "min_words", "max_words", "pattern" ] } } } }
				},
				{
					"if": { "required": [ "type" ], "properties": { "type": { "const": "number" } } },
					"then": { "properties": { "default": { "type": "number" }, "validate": { "propertyNames": { "enum": [ "min", "max" ] } } } }
				},
				{
					"if": { "required": [ "type" ], "properties": { "type": { "const": "boolean" } } },
					"then": { "properties": { "default": { "type": "boolean" } } }
				},
				{
					"if": { "required": [ "type" ], "properties": { "type": { "const": "date" } } },
					"then": { "properties": { "default": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" } } }
				},
				{
					"if": { "required": [ "type" ], "properties": { "type": { "enum": [ "boolean", "date", "select", "post", "file" ] } } },
					"then": { "properties": { "validate": { "maxProperties": 0 } } }
				},
				{
					"if": { "required": [ "type" ], "properties": { "type": { "enum": [ "post", "file" ] } } },
					"then": { "properties": { "default": false } }
				}
			]
		},
		"option": {
			"type": "object",
			"required": [ "value", "label" ],
			"additionalProperties": false,
			"properties": {
				"value": { "$ref": "#/$defs/text" },
				"label": { "$ref": "#/$defs/text" }
			}
		},
		"condition": {
			"description": "Applies when the named field (on the same content type, or of the same form) equals the value.",
			"type": "object",
			"required": [ "field", "equals" ],
			"additionalProperties": false,
			"properties": {
				"field": { "$ref": "#/$defs/key" },
				"equals": { "type": [ "string", "number", "boolean" ] }
			}
		},
		"validate": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"min_length": { "type": "integer", "minimum": 0 },
				"max_length": { "type": "integer", "minimum": 0 },
				"min_words": { "type": "integer", "minimum": 0 },
				"max_words": { "type": "integer", "minimum": 0 },
				"min": { "type": "number" },
				"max": { "type": "number" },
				"pattern": { "type": "string", "minLength": 1, "format": "regex" }
			}
		},
		"listing": {
			"description": "Phase 2 listing: what directories of this type may filter by. The public allowlist of URL parameters.",
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"search": { "description": "Enables the q parameter (core search).", "type": "boolean", "default": false },
				"filters": {
					"type": "array",
					"items": { "$ref": "#/$defs/listing_filter" }
				}
			}
		},
		"listing_filter": {
			"type": "object",
			"required": [ "key" ],
			"additionalProperties": false,
			"properties": {
				"key": {
					"description": "URL parameter: not a WordPress query var, not q, not wp_*; also not a content type or taxonomy key (PHP only).",
					"allOf": [
						{ "$ref": "#/$defs/key" },
						{ "not": { "const": "q" } },
						{ "not": { "pattern": "^wp_" } },
						{ "not": { "$ref": "#/$defs/reserved_key" } }
					]
				},
				"taxonomy": { "$ref": "#/$defs/key" },
				"field": { "$ref": "#/$defs/key" },
				"label": { "$ref": "#/$defs/text" },
				"multiple": { "type": "boolean" }
			},
			"oneOf": [
				{ "required": [ "taxonomy" ] },
				{ "required": [ "field" ] }
			]
		},
		"taxonomy": {
			"title": "Taxonomy (taxonomies/<key>.json)",
			"type": "object",
			"required": [ "format", "key", "labels" ],
			"additionalProperties": false,
			"properties": {
				"format": { "$ref": "#/$defs/format" },
				"key": {
					"allOf": [
						{ "$ref": "#/$defs/object_key" },
						{ "maxLength": 32 }
					]
				},
				"labels": { "$ref": "#/$defs/labels" },
				"hierarchical": { "type": "boolean", "default": false },
				"locked_terms": {
					"description": "Only users with manage_options add terms.",
					"type": "boolean",
					"default": false
				},
				"terms": {
					"description": "Seed terms.",
					"type": "array",
					"items": { "$ref": "#/$defs/term" }
				},
				"wp": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"rewrite_slug": { "$ref": "#/$defs/text" }
					}
				}
			}
		},
		"term": {
			"type": "object",
			"required": [ "slug", "name" ],
			"additionalProperties": false,
			"properties": {
				"slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
				"name": { "$ref": "#/$defs/text" }
			}
		},
		"relationship": {
			"title": "Relationship (relationships/<key>.json). Stored as one _rel_<key> meta row per linked ID on the \"from\" record. The PHP validator also rejects from equal to to, and a _rel_<key> that is already a field meta key on the \"from\" type.",
			"type": "object",
			"required": [ "format", "key", "from", "to", "cardinality" ],
			"additionalProperties": false,
			"properties": {
				"format": { "$ref": "#/$defs/format" },
				"key": { "$ref": "#/$defs/key" },
				"from": { "$ref": "#/$defs/key" },
				"to": { "$ref": "#/$defs/key" },
				"cardinality": {
					"description": "many_to_many: no limit. one_to_many: each \"to\" record is linked from at most one \"from\" record.",
					"enum": [ "one_to_many", "many_to_many" ]
				},
				"storage": { "description": "table is reserved for Phase 5.", "enum": [ "meta" ], "default": "meta" },
				"label": { "description": "Picker heading on the \"from\" editor. Default: the \"to\" type's plural label.", "$ref": "#/$defs/text" },
				"required": { "description": "At least one link on publish, pending and future.", "type": "boolean", "default": false }
			}
		},
		"options_page": {
			"title": "Options page (options-pages/<key>.json): one option named by the key, edited on a settings screen",
			"type": "object",
			"required": [ "format", "key", "title", "fields" ],
			"additionalProperties": false,
			"properties": {
				"format": { "$ref": "#/$defs/format" },
				"key": {
					"allOf": [
						{ "$ref": "#/$defs/bounded_key" },
						{ "not": { "pattern": "^(wp_|pegwork_)" } },
						{ "not": { "$ref": "#/$defs/reserved_option_name" } }
					]
				},
				"title": { "$ref": "#/$defs/text" },
				"menu_title": { "description": "Default: title.", "$ref": "#/$defs/text" },
				"capability": { "$ref": "#/$defs/capability", "default": "manage_options" },
				"fields": {
					"type": "array",
					"items": { "$ref": "#/$defs/options_page_field" }
				}
			}
		},
		"options_page_field": {
			"description": "Content type field rules plus type post (one post ID); no conditions and no wp storage mapping.",
			"type": "object",
			"required": [ "key", "type", "label" ],
			"additionalProperties": false,
			"properties": {
				"key": { "$ref": "#/$defs/key" },
				"type": { "enum": [ "text", "textarea", "rich_text", "url", "email", "boolean", "date", "number", "select", "post" ] },
				"label": { "$ref": "#/$defs/text" },
				"required": { "type": "boolean", "default": false },
				"visibility": { "enum": [ "public", "private" ], "default": "public" },
				"default": {},
				"options": {
					"type": "array",
					"items": { "$ref": "#/$defs/option" }
				},
				"validate": { "$ref": "#/$defs/validate" },
				"post_type": { "description": "Content type of a post field.", "$ref": "#/$defs/key" }
			},
			"allOf": [
				{ "$ref": "#/$defs/field_type_rules" },
				{
					"if": { "required": [ "type" ], "properties": { "type": { "const": "post" } } },
					"then": { "required": [ "post_type" ] },
					"else": { "properties": { "post_type": false } }
				}
			]
		},
		"form": {
			"title": "Form (forms/<key>.json)",
			"type": "object",
			"required": [ "format", "key", "label" ],
			"additionalProperties": false,
			"properties": {
				"format": { "$ref": "#/$defs/format" },
				"key": { "$ref": "#/$defs/bounded_key" },
				"label": { "$ref": "#/$defs/text" },
				"target": {
					"type": "object",
					"required": [ "content_type" ],
					"additionalProperties": false,
					"properties": {
						"content_type": { "$ref": "#/$defs/key" },
						"action": { "enum": [ "create", "update" ], "default": "create" },
						"status": { "enum": [ "draft", "pending", "publish" ], "description": "Default for create: pending." }
					}
				},
				"access": {
					"default": "anyone",
					"oneOf": [
						{ "const": "anyone" },
						{
							"type": "object",
							"required": [ "capability" ],
							"additionalProperties": false,
							"properties": { "capability": { "$ref": "#/$defs/capability" } }
						}
					]
				},
				"confirm": {
					"type": "object",
					"required": [ "field", "subject", "body" ],
					"additionalProperties": false,
					"properties": {
						"field": { "$ref": "#/$defs/key" },
						"subject": { "$ref": "#/$defs/text" },
						"body": { "type": "string", "pattern": "\\{confirm_url\\}" },
						"expires_hours": { "type": "integer", "minimum": 1, "default": 72 }
					}
				},
				"captcha": { "enum": [ "turnstile" ] },
				"fields": {
					"type": "array",
					"items": { "$ref": "#/$defs/form_item" }
				},
				"steps": {
					"type": "array",
					"items": { "$ref": "#/$defs/form_step" }
				},
				"notifications": {
					"type": "array",
					"items": { "$ref": "#/$defs/notification" }
				},
				"messages": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"success": { "$ref": "#/$defs/text" },
						"submit_label": { "$ref": "#/$defs/text" },
						"confirm_failed": { "$ref": "#/$defs/text" },
						"confirmed": { "$ref": "#/$defs/text" }
					}
				},
				"retention_days": { "type": "integer", "minimum": 1 }
			},
			"oneOf": [
				{ "required": [ "fields" ] },
				{ "required": [ "steps" ] }
			],
			"allOf": [
				{
					"if": {
						"required": [ "target" ],
						"properties": {
							"target": {
								"anyOf": [
									{ "required": [ "status" ], "properties": { "status": { "const": "publish" } } },
									{ "required": [ "action" ], "properties": { "action": { "const": "update" } } }
								]
							}
						}
					},
					"then": { "required": [ "access" ], "properties": { "access": { "type": "object" } } }
				},
				{
					"if": { "not": { "required": [ "target" ] } },
					"then": {
						"properties": {
							"fields": { "items": { "not": { "required": [ "bind" ] } } },
							"steps": { "items": { "properties": { "fields": { "items": { "not": { "required": [ "bind" ] } } } } } }
						}
					}
				},
				{
					"if": { "required": [ "confirm" ] },
					"then": {
						"properties": {
							"notifications": {
								"items": {
									"if": { "required": [ "when" ], "properties": { "when": { "const": "submitted" } } },
									"then": { "properties": { "to": { "not": { "pattern": "^\\{field:" } } } }
								}
							}
						}
					}
				}
			]
		},
		"form_step": {
			"type": "object",
			"required": [ "key", "label", "fields" ],
			"additionalProperties": false,
			"properties": {
				"key": { "$ref": "#/$defs/key" },
				"label": { "$ref": "#/$defs/text" },
				"description": { "$ref": "#/$defs/text" },
				"fields": {
					"type": "array",
					"items": { "$ref": "#/$defs/form_item" }
				}
			}
		},
		"form_item": {
			"description": "A bound item (bind) or an unbound field.",
			"if": { "required": [ "bind" ] },
			"then": { "$ref": "#/$defs/form_bound_item" },
			"else": { "$ref": "#/$defs/form_field" }
		},
		"form_display": { "enum": [ "radio", "checkboxes", "select" ] },
		"form_bound_item": {
			"description": "Inherits type, rules, conditions and options from the bound content type field or taxonomy; overrides are presentational.",
			"type": "object",
			"required": [ "bind" ],
			"additionalProperties": false,
			"properties": {
				"bind": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"field": { "$ref": "#/$defs/key" },
						"taxonomy": { "$ref": "#/$defs/key" }
					},
					"oneOf": [
						{ "required": [ "field" ] },
						{ "required": [ "taxonomy" ] }
					]
				},
				"label": { "$ref": "#/$defs/text" },
				"help": { "$ref": "#/$defs/text" },
				"placeholder": { "$ref": "#/$defs/text" },
				"autocomplete": { "$ref": "#/$defs/text" },
				"display": { "$ref": "#/$defs/form_display" }
			}
		},
		"form_field": {
			"description": "Unbound form field: content type field rules plus type file; no visibility or wp.",
			"type": "object",
			"required": [ "key", "type", "label" ],
			"additionalProperties": false,
			"properties": {
				"key": { "$ref": "#/$defs/key" },
				"type": { "enum": [ "text", "textarea", "rich_text", "url", "email", "boolean", "date", "number", "select", "file" ] },
				"label": { "$ref": "#/$defs/text" },
				"required": { "type": "boolean", "default": false },
				"default": {},
				"options": {
					"type": "array",
					"items": { "$ref": "#/$defs/option" }
				},
				"required_when": { "$ref": "#/$defs/condition" },
				"show_when": { "$ref": "#/$defs/condition" },
				"validate": { "$ref": "#/$defs/validate" },
				"help": { "$ref": "#/$defs/text" },
				"placeholder": { "$ref": "#/$defs/text" },
				"autocomplete": { "$ref": "#/$defs/text" },
				"display": { "$ref": "#/$defs/form_display" },
				"accept": {
					"description": "Allowed file extensions, lowercase, without the dot.",
					"type": "array",
					"items": { "$ref": "#/$defs/extension" }
				},
				"max_size_mb": { "type": "number", "exclusiveMinimum": 0 }
			},
			"allOf": [
				{ "$ref": "#/$defs/field_type_rules" },
				{
					"if": { "required": [ "type" ], "properties": { "type": { "const": "file" } } },
					"then": { "required": [ "accept" ] },
					"else": { "properties": { "accept": false, "max_size_mb": false } }
				}
			]
		},
		"extension": {
			"type": "string",
			"pattern": "^[a-z0-9]+$",
			"not": { "pattern": "^(php[a-z0-9]*|phtml|pht|phar|html?|xhtml|shtml|svgz?|m?js|exe)$" }
		},
		"notification": {
			"type": "object",
			"required": [ "key", "when", "to", "subject", "body" ],
			"additionalProperties": false,
			"properties": {
				"key": { "$ref": "#/$defs/key" },
				"when": { "enum": [ "submitted", "confirmed" ] },
				"to": { "$ref": "#/$defs/recipient" },
				"reply_to": { "$ref": "#/$defs/recipient" },
				"subject": { "$ref": "#/$defs/text" },
				"body": { "$ref": "#/$defs/text" }
			}
		},
		"recipient": {
			"description": "An email address, {admin_email}, {field:<email field>} or {option:<page>.<email field>}.",
			"type": "string",
			"anyOf": [
				{ "pattern": "^[^\\s@{}]+@[^\\s@{}]+\\.[^\\s@{}]+$" },
				{ "pattern": "^\\{(?:admin_email|field:[a-z][a-z0-9_]*|option:[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*)\\}$" }
			]
		},
		"automation": {
			"title": "Automation (automations/<key>.json)",
			"type": "object",
			"required": [ "format", "key", "label", "trigger", "steps" ],
			"additionalProperties": false,
			"properties": {
				"format": { "$ref": "#/$defs/format" },
				"key": { "$ref": "#/$defs/bounded_key" },
				"label": { "$ref": "#/$defs/text" },
				"description": { "$ref": "#/$defs/text" },
				"enabled": { "type": "boolean", "default": true },
				"trigger": { "$ref": "#/$defs/trigger" },
				"steps": { "$ref": "#/$defs/steps" },
				"idempotency": { "description": "Template; a run is not created when one with the same rendered key exists.", "$ref": "#/$defs/text" },
				"links": {
					"description": "Signed one-click links by name.",
					"type": "object",
					"propertyNames": { "allOf": [ { "$ref": "#/$defs/key" }, { "$ref": "#/$defs/not_callable" } ] },
					"additionalProperties": { "$ref": "#/$defs/link" }
				},
				"ui": {
					"description": "Reserved for the Phase 6 canvas; ignored by the engine, preserved by the normalizer.",
					"type": "object",
					"allOf": [ { "$ref": "#/$defs/free" } ]
				}
			}
		},
		"trigger": {
			"type": "object",
			"required": [ "type" ],
			"properties": {
				"type": { "enum": [ "event", "schedule", "webhook", "manual" ] }
			},
			"allOf": [
				{
					"if": { "properties": { "type": { "const": "manual" } } },
					"then": { "$ref": "#/$defs/trigger_manual" }
				},
				{
					"if": { "properties": { "type": { "const": "event" } } },
					"then": { "$ref": "#/$defs/trigger_event" }
				},
				{
					"if": { "properties": { "type": { "const": "schedule" } } },
					"then": { "$ref": "#/$defs/trigger_schedule" }
				},
				{
					"if": { "properties": { "type": { "const": "webhook" } } },
					"then": { "additionalProperties": false, "properties": { "type": true } }
				}
			]
		},
		"trigger_event": {
			"required": [ "type", "event" ],
			"additionalProperties": false,
			"properties": {
				"type": true,
				"event": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
				"content_type": { "$ref": "#/$defs/key" },
				"form": { "$ref": "#/$defs/key" },
				"when": { "$ref": "#/$defs/expression" }
			},
			"allOf": [
				{
					"if": { "required": [ "content_type" ] },
					"then": { "properties": { "event": { "pattern": "^record\\." } } }
				},
				{
					"if": { "required": [ "form" ] },
					"then": { "properties": { "event": { "pattern": "^form\\." } } }
				}
			]
		},
		"trigger_schedule": {
			"required": [ "type", "every" ],
			"additionalProperties": false,
			"properties": {
				"type": true,
				"every": { "enum": [ "hour", "day", "week" ] },
				"at": { "description": "Site time, HH:MM.", "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
				"for_each": {
					"type": "object",
					"required": [ "content_type" ],
					"additionalProperties": false,
					"properties": {
						"content_type": { "$ref": "#/$defs/key" },
						"status": {
							"type": "array",
							"items": { "enum": [ "publish", "future", "draft", "pending", "private" ] },
							"default": [ "publish" ]
						},
						"where": { "$ref": "#/$defs/expression" },
						"max_runs": { "type": "integer", "minimum": 1, "default": 200 }
					}
				}
			}
		},
		"trigger_manual": {
			"description": "A Run button: on the edit screen of content_type's records (the run binds the record), or Run now on the list without content_type.",
			"required": [ "type", "button" ],
			"additionalProperties": false,
			"properties": {
				"type": true,
				"content_type": { "$ref": "#/$defs/key" },
				"button": { "type": "string", "minLength": 1, "maxLength": 40 },
				"allow": { "description": "admins: manage_options; editors: users who can edit the record.", "enum": [ "admins", "editors" ], "default": "admins" },
				"when": { "$ref": "#/$defs/expression" }
			},
			"if": { "required": [ "allow" ], "properties": { "allow": { "const": "editors" } } },
			"then": { "required": [ "content_type" ] }
		},
		"duration": {
			"description": "ISO 8601 duration, such as P30D or PT1H. Waits and link expiry: PT1H to P2Y (PHP only).",
			"type": "string",
			"pattern": "^P(?!$)([0-9]+Y)?([0-9]+M)?([0-9]+W)?([0-9]+D)?(T(?=[0-9])([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$"
		},
		"steps": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/step" }
		},
		"link_steps": {
			"type": "array",
			"minItems": 1,
			"items": {
				"allOf": [
					{ "$ref": "#/$defs/step" },
					{ "properties": { "type": { "enum": [ "update_record", "condition" ] } } }
				]
			}
		},
		"step": {
			"type": "object",
			"required": [ "id", "type" ],
			"properties": {
				"type": { "enum": [ "update_record", "create_record", "send_email", "call_webhook", "wait", "condition", "decision", "get_record", "find_records", "loop", "relate" ] }
			},
			"allOf": [
				{
					"if": { "properties": { "type": { "const": "decision" } } },
					"then": { "$ref": "#/$defs/decision" }
				},
				{
					"if": { "properties": { "type": { "const": "get_record" } } },
					"then": { "$ref": "#/$defs/get_record" }
				},
				{
					"if": { "properties": { "type": { "const": "find_records" } } },
					"then": { "$ref": "#/$defs/find_records" }
				},
				{
					"if": { "properties": { "type": { "const": "loop" } } },
					"then": { "$ref": "#/$defs/loop" }
				},
				{
					"if": { "properties": { "type": { "const": "relate" } } },
					"then": { "$ref": "#/$defs/relate" }
				},
				{
					"if": { "properties": { "type": { "const": "update_record" } } },
					"then": {
						"required": [ "values" ],
						"additionalProperties": false,
						"properties": {
							"id": { "$ref": "#/$defs/key" },
							"type": true,
							"retry": { "$ref": "#/$defs/retry" },
							"on_error": { "$ref": "#/$defs/on_error" },
							"record": { "description": "Template for the record ID; default the bound record.", "$ref": "#/$defs/text" },
							"values": { "$ref": "#/$defs/values" }
						}
					}
				},
				{
					"if": { "properties": { "type": { "const": "create_record" } } },
					"then": {
						"required": [ "content_type", "values" ],
						"additionalProperties": false,
						"properties": {
							"id": { "$ref": "#/$defs/key" },
							"type": true,
							"retry": { "$ref": "#/$defs/retry" },
							"on_error": { "$ref": "#/$defs/on_error" },
							"content_type": { "$ref": "#/$defs/key" },
							"status": { "enum": [ "draft", "pending", "publish", "private" ], "default": "draft" },
							"values": { "$ref": "#/$defs/values" }
						}
					}
				},
				{
					"if": { "properties": { "type": { "const": "send_email" } } },
					"then": {
						"required": [ "to", "subject", "text" ],
						"additionalProperties": false,
						"properties": {
							"id": { "$ref": "#/$defs/key" },
							"type": true,
							"retry": { "$ref": "#/$defs/retry" },
							"on_error": { "$ref": "#/$defs/on_error" },
							"to": { "$ref": "#/$defs/text" },
							"subject": { "$ref": "#/$defs/text" },
							"text": { "$ref": "#/$defs/text" },
							"html": { "$ref": "#/$defs/text" },
							"reply_to": { "$ref": "#/$defs/text" }
						}
					}
				},
				{
					"if": { "properties": { "type": { "const": "call_webhook" } } },
					"then": {
						"required": [ "url" ],
						"additionalProperties": false,
						"properties": {
							"id": { "$ref": "#/$defs/key" },
							"type": true,
							"retry": { "$ref": "#/$defs/retry" },
							"on_error": { "$ref": "#/$defs/on_error" },
							"url": { "type": "string", "pattern": "^https?://\\S+$" },
							"fields": { "description": "Public fields of the record to send (the bound record, or \"record\").", "type": "array", "items": { "$ref": "#/$defs/key" } },
							"timeout": { "type": "number", "exclusiveMinimum": 0, "maximum": 15 },
							"record": { "description": "Template for the ID of a record to send instead of the bound record; needs content_type.", "$ref": "#/$defs/text" },
							"content_type": { "$ref": "#/$defs/key" }
						},
						"dependentRequired": { "record": [ "content_type" ], "content_type": [ "record" ] }
					}
				},
				{
					"if": { "properties": { "type": { "const": "wait" } } },
					"then": {
						"required": [ "for" ],
						"additionalProperties": false,
						"properties": {
							"id": { "$ref": "#/$defs/key" },
							"type": true,
							"retry": { "$ref": "#/$defs/retry" },
							"for": { "$ref": "#/$defs/duration" }
						}
					}
				},
				{
					"if": { "properties": { "type": { "const": "condition" } } },
					"then": {
						"required": [ "when" ],
						"additionalProperties": false,
						"properties": {
							"id": { "$ref": "#/$defs/key" },
							"type": true,
							"retry": { "$ref": "#/$defs/retry" },
							"when": { "$ref": "#/$defs/expression" }
						}
					}
				}
			]
		},
		"decision": {
			"description": "Runs the steps of the first branch whose \"when\" holds, else \"otherwise\", then continues after the decision. Unique branch labels, unique step ids across the tree, at most 3 nesting levels and the output scope rule are PHP only.",
			"required": [ "id", "type", "branches" ],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/$defs/key" },
				"type": true,
				"branches": {
					"type": "array",
					"minItems": 1,
					"maxItems": 10,
					"items": {
						"type": "object",
						"required": [ "label", "when", "steps" ],
						"additionalProperties": false,
						"properties": {
							"label": { "$ref": "#/$defs/text" },
							"when": { "$ref": "#/$defs/expression" },
							"steps": { "$ref": "#/$defs/branch_steps" }
						}
					}
				},
				"otherwise": { "description": "Runs when no branch matches. An empty list is dropped by the normalizer.", "$ref": "#/$defs/branch_steps" }
			}
		},
		"branch_steps": {
			"description": "Steps of a branch; may be empty (the branch matches and does nothing).",
			"type": "array",
			"items": { "$ref": "#/$defs/step" }
		},
		"retry": {
			"type": "object",
			"required": [ "max" ],
			"additionalProperties": false,
			"properties": {
				"max": { "type": "integer", "minimum": 0 },
				"backoff": {
					"anyOf": [
						{ "$ref": "#/$defs/duration" },
						{ "type": "array", "items": { "$ref": "#/$defs/duration" } }
					]
				}
			}
		},
		"values": {
			"description": "Values by registry field or taxonomy key: template strings or literals.",
			"type": "object",
			"minProperties": 1,
			"propertyNames": { "$ref": "#/$defs/not_callable" },
			"additionalProperties": {
				"anyOf": [
					{ "type": [ "string", "number", "boolean" ] },
					{ "description": "Taxonomy term slugs.", "type": "array", "items": { "type": "string" } },
					{ "description": "Record IDs of a relationship whose \"from\" end is the written type (replaces its links).", "type": "array", "items": { "type": "integer" } }
				]
			}
		},
		"on_error": {
			"description": "After the step's retries, a failure is logged, outputs failed and error are set, and the run continues.",
			"const": "continue"
		},
		"read_query": {
			"description": "Read query model shared by get_record and find_records. Field names, operator and literal types, relationship ends and sortable fields are checked against the registry in PHP only.",
			"properties": {
				"content_type": { "$ref": "#/$defs/key" },
				"related": {
					"type": "object",
					"required": [ "relationship", "of" ],
					"additionalProperties": false,
					"properties": {
						"relationship": { "$ref": "#/$defs/key" },
						"of": { "description": "Template giving a record ID at the relationship's other end.", "$ref": "#/$defs/text" }
					}
				},
				"filter": {
					"type": "object",
					"oneOf": [
						{
							"required": [ "all" ],
							"additionalProperties": false,
							"properties": { "all": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/read_leaf" } } }
						},
						{
							"required": [ "any" ],
							"additionalProperties": false,
							"properties": { "any": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/read_leaf" } } }
						}
					]
				},
				"status": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": { "enum": [ "publish", "future", "draft", "pending", "private" ] },
					"default": [ "private", "publish" ]
				},
				"sort": {
					"type": "object",
					"required": [ "field" ],
					"additionalProperties": false,
					"properties": {
						"field": { "description": "id, or a text, number, date, select or email field, or a title-storage field.", "$ref": "#/$defs/key" },
						"order": { "enum": [ "asc", "desc" ], "default": "asc" }
					},
					"default": { "field": "id", "order": "asc" }
				}
			}
		},
		"read_leaf": {
			"type": "object",
			"required": [ "field", "op" ],
			"additionalProperties": false,
			"properties": {
				"field": { "description": "A field or taxonomy key of content_type, or id; not rich_text, textarea or post_content fields.", "$ref": "#/$defs/key" },
				"op": { "enum": [ "eq", "ne", "in", "not_in", "lt", "lte", "gt", "gte", "empty", "not_empty", "contains" ] },
				"value": true
			},
			"allOf": [
				{
					"if": { "required": [ "op" ], "properties": { "op": { "enum": [ "empty", "not_empty" ] } } },
					"then": { "not": { "required": [ "value" ] } }
				},
				{
					"if": { "required": [ "op" ], "properties": { "op": { "enum": [ "in", "not_in" ] } } },
					"then": {
						"required": [ "value" ],
						"properties": { "value": { "type": "array", "minItems": 1, "items": { "type": [ "string", "number", "boolean" ] } } }
					}
				},
				{
					"if": { "required": [ "op" ], "properties": { "op": { "enum": [ "eq", "ne", "lt", "lte", "gt", "gte", "contains" ] } } },
					"then": { "required": [ "value" ], "properties": { "value": { "$ref": "#/$defs/operand" } } }
				}
			]
		},
		"get_record": {
			"description": "Reads one record (the first by sort): by \"record\" (an ID), or by \"related\" and/or \"filter\". Outputs found, record_id and record.<key>.",
			"required": [ "id", "type", "content_type" ],
			"additionalProperties": false,
			"allOf": [ { "$ref": "#/$defs/read_query" } ],
			"properties": {
				"id": { "$ref": "#/$defs/key" },
				"type": true,
				"retry": { "$ref": "#/$defs/retry" },
				"on_error": { "$ref": "#/$defs/on_error" },
				"content_type": true,
				"record": { "description": "Template giving one record ID.", "$ref": "#/$defs/text" },
				"related": true,
				"filter": true,
				"status": true,
				"sort": true
			},
			"anyOf": [ { "required": [ "record" ] }, { "required": [ "related" ] }, { "required": [ "filter" ] } ],
			"if": { "required": [ "record" ] },
			"then": { "not": { "anyOf": [ { "required": [ "related" ] }, { "required": [ "filter" ] } ] } }
		},
		"find_records": {
			"description": "Reads up to limit records, plus count and sums over every match. Outputs count, records (loop over and {{#each}} only) and sum.<field>.",
			"required": [ "id", "type", "content_type" ],
			"additionalProperties": false,
			"allOf": [ { "$ref": "#/$defs/read_query" } ],
			"properties": {
				"id": { "$ref": "#/$defs/key" },
				"type": true,
				"retry": { "$ref": "#/$defs/retry" },
				"on_error": { "$ref": "#/$defs/on_error" },
				"content_type": true,
				"related": true,
				"filter": true,
				"status": true,
				"sort": true,
				"limit": { "description": "Records loaded; 0 loads none (totals only).", "type": "integer", "minimum": 0, "maximum": 50, "default": 10 },
				"sum": { "description": "Number fields to total over every match.", "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/key" } }
			},
			"anyOf": [ { "required": [ "related" ] }, { "required": [ "filter" ] } ]
		},
		"loop": {
			"description": "Runs its steps once per record of a find_records result (at most 50). Inside: steps.<loop>.item.<key> and steps.<loop>.index; after: steps.<loop>.count. Body outputs stay inside the body, at most 10 steps counting nested ones, and the 500-attempt bound are PHP only.",
			"required": [ "id", "type", "over", "steps" ],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/$defs/key" },
				"type": true,
				"over": { "type": "string", "pattern": "^steps\\.[a-z][a-z0-9_]*\\.records$" },
				"steps": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/loop_step" } }
			}
		},
		"loop_step": {
			"description": "A step inside a loop body: no wait and no loop at any depth.",
			"allOf": [
				{ "$ref": "#/$defs/step" },
				{ "properties": { "type": { "not": { "enum": [ "wait", "loop" ] } } } },
				{
					"if": { "properties": { "type": { "const": "decision" } } },
					"then": {
						"properties": {
							"branches": { "items": { "properties": { "steps": { "items": { "$ref": "#/$defs/loop_step" } } } } },
							"otherwise": { "items": { "$ref": "#/$defs/loop_step" } }
						}
					}
				}
			]
		},
		"relate": {
			"description": "Adds or removes one link. from defaults to the bound record when it is of the relationship's from type (PHP only).",
			"required": [ "id", "type", "relationship", "to" ],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/$defs/key" },
				"type": true,
				"retry": { "$ref": "#/$defs/retry" },
				"on_error": { "$ref": "#/$defs/on_error" },
				"relationship": { "$ref": "#/$defs/key" },
				"action": { "enum": [ "add", "remove" ], "default": "add" },
				"from": { "$ref": "#/$defs/text" },
				"to": { "$ref": "#/$defs/text" }
			}
		},
		"link": {
			"type": "object",
			"required": [ "expires", "steps" ],
			"additionalProperties": false,
			"properties": {
				"expires": { "$ref": "#/$defs/duration" },
				"confirm": { "description": "GET shows a button that POSTs, so mail scanners cannot act.", "type": "boolean", "default": true },
				"button": { "$ref": "#/$defs/text" },
				"steps": { "$ref": "#/$defs/link_steps" },
				"success_url": { "$ref": "#/$defs/text" },
				"success_message": { "$ref": "#/$defs/text" },
				"expired_url": { "$ref": "#/$defs/text" }
			}
		},
		"expression": {
			"description": "Automation condition: { all }, { any }, { not } or a { var, op, value } leaf. Depth and size limits are PHP only.",
			"type": "object",
			"oneOf": [
				{
					"required": [ "all" ],
					"additionalProperties": false,
					"properties": { "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/expression" } } }
				},
				{
					"required": [ "any" ],
					"additionalProperties": false,
					"properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/expression" } } }
				},
				{
					"required": [ "not" ],
					"additionalProperties": false,
					"properties": { "not": { "$ref": "#/$defs/expression" } }
				},
				{ "$ref": "#/$defs/expression_leaf" }
			]
		},
		"var_path": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
		},
		"expression_leaf": {
			"type": "object",
			"required": [ "var", "op" ],
			"additionalProperties": false,
			"properties": {
				"var": { "$ref": "#/$defs/var_path" },
				"op": { "enum": [ "eq", "ne", "in", "not_in", "lt", "lte", "gt", "gte", "empty", "not_empty", "contains", "changed" ] },
				"value": true
			},
			"allOf": [
				{
					"if": { "required": [ "op" ], "properties": { "op": { "enum": [ "empty", "not_empty", "changed" ] } } },
					"then": { "not": { "required": [ "value" ] } }
				},
				{
					"if": { "required": [ "op" ], "properties": { "op": { "enum": [ "in", "not_in" ] } } },
					"then": {
						"required": [ "value" ],
						"properties": { "value": { "type": "array", "minItems": 1, "items": { "type": [ "string", "number", "boolean" ] } } }
					}
				},
				{
					"if": { "required": [ "op" ], "properties": { "op": { "enum": [ "eq", "ne", "lt", "lte", "gt", "gte", "contains" ] } } },
					"then": { "required": [ "value" ], "properties": { "value": { "$ref": "#/$defs/operand" } } }
				}
			]
		},
		"operand": {
			"anyOf": [
				{ "type": [ "string", "number", "boolean" ] },
				{
					"type": "object",
					"required": [ "var" ],
					"additionalProperties": false,
					"properties": { "var": { "$ref": "#/$defs/var_path" } }
				},
				{
					"type": "object",
					"required": [ "date" ],
					"additionalProperties": false,
					"properties": {
						"date": { "enum": [ "today", "now" ] },
						"offset": { "type": "string", "pattern": "^[-+]?P(?!$)([0-9]+Y)?([0-9]+M)?([0-9]+W)?([0-9]+D)?(T(?=[0-9])([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$" }
					}
				}
			]
		}
	}
}
