{
  "format": 1,
  "key": "suggest",
  "label": "Suggest a thing",
  "target": {
    "content_type": "thing"
  },
  "fields": [
    {
      "bind": {
        "field": "name"
      }
    },
    {
      "bind": {
        "field": "email"
      }
    }
  ],
  "confirm": {
    "field": "email",
    "subject": "Confirm",
    "body": "{confirm_url}"
  },
  "notifications": [
    {
      "key": "sender",
      "when": "submitted",
      "to": "{field:email}",
      "subject": "Thanks",
      "body": "Thanks."
    }
  ]
}
