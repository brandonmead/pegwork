        { "id": "three", "type": "decision", "branches": [ { "label": "C", "when": { "var": "record.count", "op": "gt", "value": 2 }, "steps": [
          { "id": "four", "type": "decision", "branches": [ { "label": "D", "when": { "var": "record.count", "op": "gt", "value": 3 }, "steps": [
            { "id": "mark", "type": "update_record", "values": { "done": false } } ] } ] } ] } ] } ] } ] } ] } ] }
  ]
