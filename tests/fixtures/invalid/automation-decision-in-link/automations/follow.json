{
  "format": 1,
  "key": "follow",
  "label": "Follow up",
  "trigger": { "type": "event", "event": "record.created", "content_type": "thing" },
  "steps": [
    { "id": "mail", "type": "send_email", "to": "ops@example.org", "subject": "Check", "text": "Approve: {{link.approve}}" }
  ],
  "links": {
    "approve": { "expires": "P7D",
      "steps": [ { "id": "route", "type": "decision", "branches": [ { "label": "Done", "when": { "var": "record.done", "op": "eq", "value": true },
        "steps": [ { "id": "mark", "type": "update_record", "values": { "done": false } } ] } ] } ] }
  }
}
