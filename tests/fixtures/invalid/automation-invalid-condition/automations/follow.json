{
  "format": 1,
  "key": "follow",
  "label": "Follow up",
  "trigger": {
    "type": "event",
    "event": "record.published",
    "content_type": "thing",
    "when": {
      "all": [
        {
          "var": "record.done",
          "op": "eq",
          "value": true
        }
      ],
      "any": [
        {
          "var": "record.done",
          "op": "eq",
          "value": false
        }
      ]
    }
  },
  "steps": [
    {
      "id": "mail",
      "type": "send_email",
      "to": "ops@example.org",
      "subject": "Hi",
      "text": "Hi"
    }
  ]
}
