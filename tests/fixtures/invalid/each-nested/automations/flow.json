{
    "format": 1,
    "key": "flow",
    "label": "Flow",
    "trigger": {
        "type": "schedule",
        "every": "week"
    },
    "steps": [
        {
            "id": "due",
            "type": "find_records",
            "content_type": "barn_task",
            "filter": {
                "all": [
                    {
                        "field": "done",
                        "op": "ne",
                        "value": true
                    }
                ]
            }
        },
        {
            "id": "summary",
            "type": "send_email",
            "to": "{{option:barn_settings.development_email}}",
            "subject": "Hi",
            "text": "{{#each steps.due.records}}{{item.name}}{{#each steps.due.records}}{{item.name}}{{/each}}{{/each}}"
        }
    ]
}
