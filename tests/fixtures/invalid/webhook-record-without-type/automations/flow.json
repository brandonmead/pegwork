{
    "format": 1,
    "key": "flow",
    "label": "Flow",
    "trigger": {
        "type": "event",
        "event": "record.created",
        "content_type": "barn_gift"
    },
    "steps": [
        {
            "id": "donor",
            "type": "get_record",
            "content_type": "barn_contact",
            "related": {
                "relationship": "gift_donor",
                "of": "{{record.id}}"
            }
        },
        {
            "id": "send",
            "type": "call_webhook",
            "url": "https://hooks.example.org/donor",
            "record": "{{steps.donor.record_id}}"
        }
    ]
}
