{
    "format": 1,
    "key": "flow",
    "label": "Flow",
    "trigger": {
        "type": "event",
        "event": "record.created",
        "content_type": "barn_gift"
    },
    "steps": [
        {
            "id": "gift",
            "type": "get_record",
            "content_type": "barn_gift",
            "record": "{{record.id}}",
            "filter": {
                "all": [
                    {
                        "field": "amount",
                        "op": "gt",
                        "value": 0
                    }
                ]
            }
        }
    ]
}
