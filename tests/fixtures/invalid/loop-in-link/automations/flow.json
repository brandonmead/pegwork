{
    "format": 1,
    "key": "flow",
    "label": "Flow",
    "trigger": {
        "type": "event",
        "event": "record.created",
        "content_type": "barn_gift"
    },
    "steps": [
        {
            "id": "ask",
            "type": "send_email",
            "to": "{{option:barn_settings.development_email}}",
            "subject": "Hi",
            "text": "Close: {{link.close}}"
        }
    ],
    "links": {
        "close": {
            "expires": "P7D",
            "steps": [
                {
                    "id": "each_task",
                    "type": "loop",
                    "over": "steps.due.records",
                    "steps": [
                        {
                            "id": "close",
                            "type": "update_record",
                            "values": {
                                "method": "card"
                            }
                        }
                    ]
                }
            ]
        }
    }
}
