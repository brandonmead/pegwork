{
    "format": 1,
    "key": "flow",
    "label": "Flow",
    "trigger": {
        "type": "schedule",
        "every": "week"
    },
    "steps": [
        {
            "id": "due",
            "type": "find_records",
            "content_type": "barn_task",
            "filter": {
                "all": [
                    {
                        "field": "done",
                        "op": "ne",
                        "value": true
                    }
                ]
            }
        },
        {
            "id": "each_task",
            "type": "loop",
            "over": "steps.due.records",
            "steps": [
                {
                    "id": "inner",
                    "type": "loop",
                    "over": "steps.due.records",
                    "steps": [
                        {
                            "id": "remind",
                            "type": "send_email",
                            "to": "{{option:barn_settings.development_email}}",
                            "subject": "Hi",
                            "text": "Hi"
                        }
                    ]
                }
            ]
        }
    ]
}
