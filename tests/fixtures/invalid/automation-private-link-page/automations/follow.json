{
  "format": 1,
  "key": "follow",
  "label": "Follow up",
  "trigger": {
    "type": "event",
    "event": "record.published",
    "content_type": "thing"
  },
  "steps": [
    {
      "id": "ask",
      "type": "send_email",
      "to": "ops@example.org",
      "subject": "Done?",
      "text": "{{link.done}}"
    }
  ],
  "links": {
    "done": {
      "expires": "P7D",
      "success_message": "Thanks {{record.email}}",
      "steps": [
        {
          "id": "mark",
          "type": "update_record",
          "values": {
            "done": true
          }
        }
      ]
    }
  }
}
