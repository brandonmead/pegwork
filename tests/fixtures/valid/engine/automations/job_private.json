{
  "format": 1,
  "key": "job_private",
  "label": "Made private: close it, then a step whose handler a test removes",
  "trigger": { "type": "event", "event": "record.status_changed", "content_type": "job",
    "when": { "var": "trigger.new_status", "op": "eq", "value": "private" } },
  "steps": [
    { "id": "stage", "type": "update_record", "values": { "job_stage": "closed" } },
    { "id": "hook", "type": "call_webhook", "url": "https://example.org/hook" }
  ]
}
