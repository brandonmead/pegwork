{ "format": 1, "key": "reads_shapes", "label": "Every read, relate, on_error and template shape",
  "trigger": { "type": "webhook" },
  "steps": [
    { "id": "gift", "type": "get_record", "content_type": "barn_gift", "record": "{{trigger.payload.gift_id}}",
      "status": [ "publish", "draft", "private" ], "on_error": "continue", "retry": { "max": 1, "backoff": "PT5M" } },
    { "id": "has_gift", "type": "condition", "when": { "all": [
      { "var": "steps.gift.failed", "op": "eq", "value": false },
      { "var": "steps.gift.found", "op": "eq", "value": true },
      { "var": "steps.gift.record.method", "op": "in", "value": [ "card", "check" ] },
      { "var": "steps.gift.record.received_on", "op": "lte", "value": { "date": "today" } } ] } },
    { "id": "donor", "type": "get_record", "content_type": "barn_contact",
      "related": { "relationship": "gift_donor", "of": "{{steps.gift.record_id}}" },
      "sort": { "field": "name", "order": "desc" } },
    { "id": "recent", "type": "find_records", "content_type": "barn_gift",
      "related": { "relationship": "gift_donor", "of": "{{steps.donor.record_id}}" },
      "filter": { "any": [
        { "field": "amount", "op": "gte", "value": { "var": "trigger.payload.minimum" } },
        { "field": "received_on", "op": "gt", "value": { "date": "today", "offset": "-P1Y" } },
        { "field": "barn_fund", "op": "contains", "value": "building" },
        { "field": "method", "op": "not_in", "value": [ "check" ] },
        { "field": "id", "op": "ne", "value": { "var": "steps.gift.record_id" } },
        { "field": "name", "op": "not_empty" } ] },
      "sort": { "field": "received_on" }, "limit": 5, "sum": [ "amount" ], "on_error": "continue" },
    { "id": "tasks", "type": "find_records", "content_type": "barn_task",
      "related": { "relationship": "task_gift", "of": "{{steps.gift.record_id}}" } },
    { "id": "link_donor", "type": "relate", "relationship": "gift_donor",
      "from": "{{steps.gift.record_id}}", "to": "{{trigger.payload.contact_id}}", "on_error": "continue" },
    { "id": "unlink_task", "type": "relate", "relationship": "task_gift", "action": "remove",
      "from": "{{trigger.payload.task_id}}", "to": "{{steps.gift.record_id}}" },
    { "id": "new_task", "type": "create_record", "content_type": "barn_task",
      "values": { "name": "Review {{steps.gift.record.name}}", "due_on": "{{option:barn_settings.campaign_ends_on | add:\"-P1W\"}}",
        "task_gift": [ 12, 15 ] } },
    { "id": "retitle", "type": "update_record", "record": "{{steps.new_task.record_id}}",
      "values": { "reminded_on": "{{now | add:\"-PT6H\" | date}}", "task_gift": "" } },
    { "id": "restamp", "type": "update_record", "record": "{{steps.donor.record_id}}",
      "values": { "last_gift_on": "{{steps.gift.record.received_on | add:\"P1D\"}}" } },
    { "id": "send", "type": "call_webhook", "url": "https://hooks.example.org/gift/{{steps.gift.record_id}}?total={{steps.recent.sum.amount|number:0}}",
      "record": "{{steps.gift.record_id}}", "content_type": "barn_gift", "fields": [ "name", "amount", "barn_fund" ],
      "on_error": "continue" },
    { "id": "report", "type": "send_email", "to": "{{option:barn_settings.development_email}}",
      "subject": "Gift {{steps.gift.record_id}}: {{steps.recent.count | number}} recent of {{option:barn_settings.goal | number}}",
      "html": "<p>{{steps.gift.record.name}}: {{steps.gift.record.amount | number:2 | default:\"none\"}}</p><ul>{{#each steps.recent.records}}<li>{{item.name}} {{item.amount | number}} {{item.received_on | add:\"P30D\" | date}} {{item.permalink}}</li>{{/each}}</ul>{{#each steps.tasks.records}}{{item.name}}{{else}}No tasks.{{/each}}",
      "text": "Lookup failed: {{steps.gift.error | default:\"no\"}}. Webhook failed: {{steps.send.failed}} {{steps.send.error}}. Linked: {{steps.link_donor.failed}}." } ] }
