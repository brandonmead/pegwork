{
  "format": 1,
  "key": "fe_project",
  "label": "Submit a project",
  "target": { "content_type": "fe_project", "action": "create", "status": "pending" },
  "confirm": { "field": "contact_email", "subject": "Confirm", "body": "Confirm: {confirm_url}" },
  "fields": [
    { "bind": { "field": "title" } },
