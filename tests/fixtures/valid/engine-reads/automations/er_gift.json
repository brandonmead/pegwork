{ "format": 1, "key": "er_gift", "label": "Gift: thank the donor, stamp them, list their gifts a month later",
  "trigger": { "type": "event", "event": "record.created", "content_type": "barn_gift" },
  "steps": [
    { "id": "donor", "type": "get_record", "content_type": "barn_contact",
      "related": { "relationship": "gift_donor", "of": "{{record.id}}" } },
    { "id": "has_donor", "type": "condition", "when": { "var": "steps.donor.found", "op": "eq", "value": true } },
    { "id": "stamp", "type": "update_record", "record": "{{steps.donor.record_id}}",
      "values": { "last_gift_on": "{{record.received_on}}" } },
    { "id": "thank", "type": "send_email", "to": "{{steps.donor.record.email}}",
      "subject": "Thank you, {{steps.donor.record.name}}",
      "text": "Gift of ${{record.amount | number:2}} on {{record.received_on | date}}. Last gift on {{steps.donor.record.last_gift_on}}. We call by {{record.received_on | add:\"P2D\" | date}}." },
    { "id": "call", "type": "create_record", "content_type": "barn_task", "status": "publish",
      "values": { "name": "Call {{steps.donor.record.name}}", "due_on": "{{today | add:\"P2D\"}}", "task_gift": "{{record.id}}" } },
    { "id": "grace", "type": "wait", "for": "P30D" },
    { "id": "giving", "type": "find_records", "content_type": "barn_gift",
      "related": { "relationship": "gift_donor", "of": "{{steps.donor.record_id}}" },
      "sort": { "field": "amount", "order": "desc" }, "sum": [ "amount" ] },
    { "id": "later", "type": "send_email", "to": "{{steps.donor.record.email}}",
      "subject": "{{steps.giving.count}} gifts, {{steps.giving.sum.amount | number}} in all",
      "text": "{{#each steps.giving.records}}- {{item.name}}: {{item.amount | number}}\n{{else}}No gifts.{{/each}}",
      "html": "<ul>{{#each steps.giving.records}}<li>{{item.name}}</li>{{/each}}</ul>" } ] }
