{ "format": 1, "key": "er_link", "label": "Inbound: link a gift to a contact and send both",
  "trigger": { "type": "webhook" },
  "steps": [
    { "id": "gift", "type": "get_record", "content_type": "barn_gift", "record": "{{trigger.payload.gift_id}}" },
    { "id": "link", "type": "relate", "relationship": "gift_donor",
      "from": "{{steps.gift.record_id}}", "to": "{{trigger.payload.contact_id}}" },
    { "id": "again", "type": "relate", "relationship": "gift_donor",
      "from": "{{steps.gift.record_id}}", "to": "{{trigger.payload.contact_id}}" },
    { "id": "donor", "type": "get_record", "content_type": "barn_contact",
      "related": { "relationship": "gift_donor", "of": "{{steps.gift.record_id}}" } },
    { "id": "unlink", "type": "relate", "relationship": "gift_donor", "action": "remove",
      "from": "{{steps.gift.record_id}}", "to": "{{trigger.payload.other_id}}", "on_error": "continue" },
    { "id": "send_gift", "type": "call_webhook", "url": "https://hooks.example.org/gift",
      "record": "{{steps.gift.record_id}}", "content_type": "barn_gift" },
    { "id": "send_donor", "type": "call_webhook", "url": "https://hooks.example.org/contact",
      "record": "{{steps.donor.record_id}}", "content_type": "barn_contact" },
    { "id": "wrong", "type": "call_webhook", "url": "https://hooks.example.org/wrong",
      "record": "{{trigger.payload.contact_id}}", "content_type": "barn_gift", "on_error": "continue" },
    { "id": "report", "type": "send_email", "to": "ops@example.org",
      "subject": "Linked gift {{steps.gift.record_id}} to {{steps.donor.record.name}}",
      "text": "Unlink failed: {{steps.unlink.failed}} ({{steps.unlink.error | default:\"none\"}}). Wrong: {{steps.wrong.error}}." } ] }
