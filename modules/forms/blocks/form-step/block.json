{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pegwork/form-step",
	"title": "Form step",
	"category": "pegwork",
	"icon": "editor-ol",
	"description": "One step of a multi-step Pegwork form: a heading and its fields.",
	"keywords": [ "step", "page", "section", "form" ],
	"textdomain": "pegwork",
	"allowedBlocks": [ "pegwork/form-field" ],
	"attributes": {
		"key": { "type": "string" },
		"label": { "type": "string" },
		"description": { "type": "string" }
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false,
		"reusable": false,
		"renaming": false,
		"lock": false
	}
}
